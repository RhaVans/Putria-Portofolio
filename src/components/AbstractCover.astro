---
interface Props {
  theme: string;
  title: string;
}

const { theme, title } = Astro.props;
---
<div class={`abstract-cover cover-${theme}`} aria-hidden="true">
  {theme === 'leadership' && (
    <svg viewBox="0 0 400 240" fill="none" class="cover-svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="grad-lead" cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="#ECB44D" stop-opacity="0.25" />
          <stop offset="60%" stop-color="#1B3A68" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#191939" stop-opacity="0.8" />
        </radialGradient>
      </defs>
      <rect width="400" height="240" fill="url(#grad-lead)" />
      <!-- Constellation / Compass -->
      <circle cx="200" cy="120" r="70" stroke="#F2E199" stroke-width="1" stroke-dasharray="4 4" stroke-opacity="0.4" />
      <circle cx="200" cy="120" r="40" stroke="#6FB8E6" stroke-width="1.2" stroke-opacity="0.5" />
      <line x1="200" y1="30" x2="200" y2="210" stroke="#F2E199" stroke-width="1" stroke-opacity="0.3" />
      <line x1="110" y1="120" x2="290" y2="120" stroke="#F2E199" stroke-width="1" stroke-opacity="0.3" />
      <circle cx="200" cy="50" r="4" fill="#ECB44D" />
      <circle cx="250" cy="120" r="3.5" fill="#6FB8E6" />
      <circle cx="160" cy="150" r="3" fill="#F2E199" />
      <circle cx="200" cy="120" r="5" fill="#ECB44D" />
      <path d="M 200 50 L 250 120 L 200 120 L 160 150 Z" stroke="#F2E199" stroke-width="1" stroke-opacity="0.4" />
    </svg>
  )}

  {theme === 'organic' && (
    <svg viewBox="0 0 400 240" fill="none" class="cover-svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="grad-org" cx="40%" cy="60%" r="65%">
          <stop offset="0%" stop-color="#6FB8E6" stop-opacity="0.25" />
          <stop offset="50%" stop-color="#1B3A68" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#191939" stop-opacity="0.8" />
        </radialGradient>
      </defs>
      <rect width="400" height="240" fill="url(#grad-org)" />
      <!-- Organic Crescent & Rind geometry -->
      <path d="M 120 180 C 120 80 280 80 280 180 C 250 120 150 120 120 180 Z" fill="#6FB8E6" fill-opacity="0.18" stroke="#6FB8E6" stroke-width="1.5" />
      <path d="M 140 170 C 140 100 260 100 260 170 C 230 130 170 130 140 170 Z" fill="#ECB44D" fill-opacity="0.12" stroke="#ECB44D" stroke-width="1" />
      <circle cx="200" cy="110" r="30" stroke="#F2E199" stroke-width="1" stroke-dasharray="3 3" stroke-opacity="0.4" />
      <circle cx="200" cy="110" r="4" fill="#F2E199" />
    </svg>
  )}

  {theme === 'editorial' && (
    <svg viewBox="0 0 400 240" fill="none" class="cover-svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="grad-edit" cx="60%" cy="40%" r="60%">
          <stop offset="0%" stop-color="#F2E199" stop-opacity="0.2" />
          <stop offset="60%" stop-color="#1B3A68" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#191939" stop-opacity="0.8" />
        </radialGradient>
      </defs>
      <rect width="400" height="240" fill="url(#grad-edit)" />
      <!-- Editorial layout plates -->
      <rect x="110" y="50" width="180" height="140" rx="8" stroke="#F2E199" stroke-width="1.2" stroke-opacity="0.4" fill="rgba(27, 58, 104, 0.4)" />
      <line x1="130" y1="80" x2="270" y2="80" stroke="#ECB44D" stroke-width="2.5" stroke-linecap="round" stroke-opacity="0.7" />
      <line x1="130" y1="105" x2="240" y2="105" stroke="#F2E199" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.5" />
      <line x1="130" y1="125" x2="260" y2="125" stroke="#F2E199" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.5" />
      <line x1="130" y1="145" x2="210" y2="145" stroke="#F2E199" stroke-width="1.2" stroke-linecap="round" stroke-opacity="0.5" />
      <circle cx="260" cy="155" r="8" fill="#6FB8E6" fill-opacity="0.4" stroke="#6FB8E6" stroke-width="1" />
    </svg>
  )}

  {theme === 'finance' && (
    <svg viewBox="0 0 400 240" fill="none" class="cover-svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="grad-fin" cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="#ECB44D" stop-opacity="0.2" />
          <stop offset="60%" stop-color="#1B3A68" stop-opacity="0.4" />
          <stop offset="100%" stop-color="#191939" stop-opacity="0.8" />
        </radialGradient>
      </defs>
      <rect width="400" height="240" fill="url(#grad-fin)" />
      <!-- Balance & Ledger geometry -->
      <line x1="120" y1="160" x2="280" y2="160" stroke="#F2E199" stroke-width="1.5" stroke-opacity="0.5" />
      <line x1="200" y1="60" x2="200" y2="160" stroke="#F2E199" stroke-width="1.5" stroke-opacity="0.5" />
      <line x1="140" y1="100" x2="260" y2="100" stroke="#ECB44D" stroke-width="2" stroke-opacity="0.8" />
      <circle cx="200" cy="60" r="5" fill="#ECB44D" />
      <circle cx="140" cy="100" r="3.5" fill="#6FB8E6" />
      <circle cx="260" cy="100" r="3.5" fill="#6FB8E6" />
      <!-- Bowls -->
      <path d="M 125 125 A 15 15 0 0 0 155 125 Z" fill="#6FB8E6" fill-opacity="0.3" stroke="#6FB8E6" stroke-width="1" />
      <line x1="140" y1="100" x2="140" y2="125" stroke="#6FB8E6" stroke-width="1" stroke-opacity="0.6" />
      <path d="M 245 125 A 15 15 0 0 0 275 125 Z" fill="#6FB8E6" fill-opacity="0.3" stroke="#6FB8E6" stroke-width="1" />
      <line x1="260" y1="100" x2="260" y2="125" stroke="#6FB8E6" stroke-width="1" stroke-opacity="0.6" />
    </svg>
  )}
</div>

<style>
  .abstract-cover {
    width: 100%;
    height: 100%;
    min-height: 200px;
    position: relative;
    overflow: hidden;
    background-color: var(--night-700);
    border-top-left-radius: inherit;
    border-top-right-radius: inherit;
  }
  .cover-svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
</style>
