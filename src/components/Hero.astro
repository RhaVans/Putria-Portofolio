---
import strings from '../content/strings.en.json';
---
<section class="hero-chapter" id="hero">
  <div class="content-shell hero-inner">
    <!-- Text Column -->
    <div class="hero-content">
      <h1 class="hero-h1 hero-title">
        <span class="hero-name-part">Putria</span>
        <span class="hero-name-part">Octavianty</span>
      </h1>
      
      <p class="hero-role text-body">{strings.hero.role}</p>
      
      <div class="hero-actions">
        <a href="#work" class="btn-primary">
          <span>{strings.hero.viewWork}</span>
        </a>
        <a href="/cv.pdf" download="Putria_Octavianty_CV.pdf" class="btn-glass glass">
          <span>{strings.hero.downloadCv}</span>
        </a>
      </div>
    </div>

    <!-- Portrait Stage (Never overlaps text, §6.1) -->
    <div class="hero-portrait-stage">
      <!-- Glow & Silhouette Separation behind head & shoulders -->
      <div class="portrait-glow" aria-hidden="true"></div>

      <!-- Restrained Crescent Moon Arc -->
      <svg class="crescent-arc" viewBox="0 0 200 200" fill="none" aria-hidden="true">
        <path
          d="M 100 16 A 84 84 0 0 1 184 100 A 84 84 0 0 1 100 184 A 74 74 0 0 0 100 16 Z"
          fill="none"
          stroke="url(#crescentGrad)"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <defs>
          <linearGradient id="crescentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#F2E199" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#ECB44D" stop-opacity="0.3" />
          </linearGradient>
        </defs>
      </svg>

      <!-- Subject Cut-out Picture Element -->
      <picture class="portrait-picture">
        <source
          srcset="/images/portrait-1200.avif 1200w, /images/portrait-800.avif 800w, /images/portrait-480.avif 480w"
          sizes="(max-width: 767px) 75vw, (max-width: 1200px) 440px, 540px"
          type="image/avif"
        />
        <source
          srcset="/images/portrait-1200.webp 1200w, /images/portrait-800.webp 800w, /images/portrait-480.webp 480w"
          sizes="(max-width: 767px) 75vw, (max-width: 1200px) 440px, 540px"
          type="image/webp"
        />
        <img
          src="/images/portrait-480.png"
          alt={strings.hero.altPortrait}
          width="480"
          height="461"
          fetchpriority="high"
          class="portrait-img"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero-chapter {
    position: relative;
    width: 100%;
    min-height: calc(100svh - 96px);
    display: flex;
    align-items: center;
    padding-top: var(--space-6);
    padding-bottom: 0;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .hero-chapter {
      min-height: calc(100svh - 100px);
      padding-top: var(--space-8);
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: inherit;
    gap: var(--space-5);
  }

  @media (min-width: 1024px) {
    .hero-inner {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: var(--space-8);
    }
  }

  /* Content Column */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    z-index: 2;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
  }

  .hero-name-part {
    display: block;
    word-break: normal;
  }

  .hero-role {
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    color: var(--text-2);
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* Portrait Stage (§5.4, §6.1) */
  .hero-portrait-stage {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
    z-index: 1;
    overflow: visible;
  }

  @media (min-width: 1024px) {
    .hero-portrait-stage {
      max-width: 520px;
      height: 100%;
      max-height: 80vh;
      margin-inline: 0;
      justify-self: end;
    }
  }

  /* Glow & separation behind black scarf */
  .portrait-glow {
    position: absolute;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(236, 180, 77, 0.35) 0%, rgba(111, 184, 230, 0.16) 45%, transparent 70%);
    filter: blur(28px);
    pointer-events: none;
    z-index: 0;
  }

  @media (min-width: 1024px) {
    .portrait-glow {
      width: 340px;
      height: 340px;
      top: 10%;
      filter: blur(40px);
    }
  }

  .crescent-arc {
    position: absolute;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 210px;
    height: 210px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
  }

  @media (min-width: 1024px) {
    .crescent-arc {
      width: 300px;
      height: 300px;
      top: 6%;
    }
  }

  .portrait-picture {
    position: relative;
    display: block;
    width: 100%;
    z-index: 1;
  }

  .portrait-img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 52vh;
    object-fit: contain;
    object-position: bottom center;
  }

  @media (min-width: 1024px) {
    .portrait-img {
      max-height: 75vh;
    }
  }

  /* One-time hero entrance animation per session (§8) */
  html:not([data-hero-entered="true"]) .hero-title {
    animation: hero-fade-rise 700ms var(--ease-ios) both;
  }

  html:not([data-hero-entered="true"]) .hero-role {
    animation: hero-fade-rise 700ms var(--ease-ios) 80ms both;
  }

  html:not([data-hero-entered="true"]) .hero-actions {
    animation: hero-fade-rise 700ms var(--ease-ios) 160ms both;
  }

  html:not([data-hero-entered="true"]) .hero-portrait-stage {
    animation: portrait-fade-scale 850ms var(--ease-ios) both;
  }

  @keyframes hero-fade-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes portrait-fade-scale {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-role,
    .hero-actions,
    .hero-portrait-stage {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
