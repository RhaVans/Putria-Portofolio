---
import experience from '../content/experience.json';
import strings from '../content/strings.en.json';
import WorkCard from './WorkCard.astro';

// Show top 3 featured experiences on Home (§5.6)
const featured = experience.slice(0, 3);
---
<section class="featured-section section-shell" id="featured" aria-labelledby="featured-heading">
  <div class="featured-header">
    <div class="header-text">
      <span class="section-eyebrow">{strings.featured.eyebrow}</span>
      <h2 id="featured-heading" class="section-heading font-display">{strings.featured.heading}</h2>
    </div>
    <a href="/work" class="btn-secondary see-all-btn">
      <span>{strings.featured.seeAll}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>

  <!-- Mobile Scroll-Snap Carousel & Desktop 3-col Grid (§5.6, §7) -->
  <div class="featured-carousel" role="region" aria-label="Featured projects carousel">
    {featured.map((exp) => (
      <div class="carousel-item">
        <WorkCard experience={exp} />
      </div>
    ))}
  </div>
</section>

<style>
  .featured-section {
    position: relative;
    z-index: 10;
    margin-bottom: 70px;
  }

  @media (min-width: 768px) {
    .featured-section {
      margin-bottom: 100px;
    }
  }

  .featured-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .section-eyebrow {
    display: block;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--sky-400);
    margin-bottom: 6px;
  }

  .section-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--starlight-200);
    line-height: 1.15;
  }

  .see-all-btn {
    min-height: 40px;
    padding: 8px 18px;
    font-size: 14px;
  }

  /* Carousel / Grid implementation (§7) */
  .featured-carousel {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 16px;
    /* Hide scrollbar while preserving scrollability */
    scrollbar-width: none;
  }

  .featured-carousel::-webkit-scrollbar {
    display: none;
  }

  .carousel-item {
    flex: 0 0 82%; /* Partial next card peeking on mobile (§7) */
    max-width: 360px;
    scroll-snap-align: start;
  }

  @media (min-width: 640px) {
    .carousel-item {
      flex: 0 0 46%;
    }
  }

  @media (min-width: 1024px) {
    .featured-carousel {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
      gap: 24px;
      padding-bottom: 0;
    }

    .carousel-item {
      flex: initial;
      max-width: none;
    }
  }
</style>
