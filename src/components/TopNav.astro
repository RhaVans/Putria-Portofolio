---
import strings from '../content/strings.en.json';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const cleanPath = currentPath.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', label: strings.nav.home },
  { href: '/about', label: strings.nav.about },
  { href: '/work', label: strings.nav.work },
  { href: '/contact', label: strings.nav.contact }
];
---
<header class="desktop-nav-wrapper" transition:name="desktop-header">
  <nav class="glass glass-capsule desktop-nav" aria-label="Primary navigation">
    {navItems.map((item) => {
      const isActive = item.href === '/'
        ? cleanPath === '/'
        : cleanPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          class={`nav-item ${isActive ? 'active' : ''}`}
          aria-current={isActive ? 'page' : undefined}
        >
          {isActive && (
            <span class="active-pill" transition:name="active-desktop-pill" />
          )}
          <span class="nav-label">{item.label}</span>
        </a>
      );
    })}
  </nav>
</header>

<style>
  .desktop-nav-wrapper {
    display: none;
    position: fixed;
    top: 24px;
    left: 0;
    right: 0;
    z-index: 50;
    justify-content: center;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .desktop-nav-wrapper {
      display: flex;
    }
  }

  .desktop-nav {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 44px;
    padding: 4px 6px;
    border-radius: var(--radius-capsule);
  }

  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 16px;
    border-radius: var(--radius-capsule);
    font-size: 0.9375rem; /* 15px */
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--duration-press) var(--ease-ios);
    z-index: 1;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }

  .nav-item:hover {
    color: var(--text-1);
  }

  .nav-item.active {
    color: var(--text-1);
  }

  .active-pill {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-capsule);
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 2px 8px rgba(8, 8, 28, 0.4);
    z-index: -1;
  }

  .nav-label {
    position: relative;
    z-index: 1;
  }
</style>
