---
import site from '../content/site.json';
import strings from '../content/strings.en.json';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const cleanPath = currentPath.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/about', label: strings.nav.about },
  { href: '/work', label: strings.nav.work },
  { href: '/contact', label: strings.nav.contact }
];
---
<header class="desktop-header section-shell" transition:persist="desktop-header">
  <div class="glass glass-pill nav-pill">
    <a href="/" class="nav-monogram">
      <span class="monogram-box" aria-hidden="true">{site.initials}</span>
      <span class="monogram-name">{site.name}</span>
    </a>

    <nav class="nav-links" aria-label="Desktop primary">
      {navItems.map((item) => {
        const isActive = cleanPath === item.href || (item.href === '/work' && cleanPath.startsWith('/work'));
        return (
          <a
            href={item.href}
            class={`nav-link ${isActive ? 'active' : ''}`}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
            {isActive && <span class="active-dot" transition:name="active-desktop-dot" />}
          </a>
        );
      })}
    </nav>

    <div class="nav-action">
      <a href={`mailto:${site.email}`} class="btn-primary say-hello-btn">
        <span>{strings.nav.sayHello}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .desktop-header {
    display: none;
    position: fixed;
    top: 20px;
    left: 0;
    right: 0;
    z-index: 50;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .desktop-header {
      display: block;
    }
  }

  .nav-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 16px 0 20px;
    box-shadow: inset 0 1px 0 rgba(242, 225, 153, 0.2), 0 20px 48px -12px rgba(8, 8, 28, 0.7);
  }

  .nav-monogram {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--starlight-200);
    text-decoration: none;
  }

  .monogram-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-chip);
    background: rgba(27, 58, 104, 0.7);
    border: 1px solid var(--border-glass);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--moon-400);
    letter-spacing: 0.05em;
  }

  .monogram-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    position: relative;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--duration-micro) var(--ease-out);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--starlight-200);
  }

  .nav-link.active {
    color: var(--moon-400);
    font-weight: 600;
  }

  .active-dot {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--moon-400);
    box-shadow: 0 0 8px var(--moon-400);
  }

  .say-hello-btn {
    min-height: 40px;
    padding: 8px 20px;
    font-size: 14px;
  }
</style>
