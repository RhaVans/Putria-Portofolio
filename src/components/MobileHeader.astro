---
import site from '../content/site.json';
---
<header class="mobile-top-header" transition:persist="mobile-top-header">
  <div class="mobile-header-inner">
    <a href="/" class="mobile-monogram" aria-label="Putria Octavianty Home">
      <span class="monogram-box">{site.initials}</span>
      <span class="monogram-text">{site.shortName}</span>
    </a>

    <a href="/cv.pdf" download="Putria_Octavianty_CV.pdf" class="glass glass-pill mobile-cv-btn" aria-label="Download CV PDF">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      <span>CV</span>
    </a>
  </div>
</header>

<style>
  .mobile-top-header {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    padding: calc(10px + env(safe-area-inset-top, 0px)) 16px 10px;
    background: linear-gradient(to bottom, rgba(25, 25, 57, 0.85) 0%, transparent 100%);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .mobile-top-header {
      display: none;
    }
  }

  .mobile-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: auto;
  }

  .mobile-monogram {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--starlight-200);
  }

  .monogram-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-chip);
    background: rgba(27, 58, 104, 0.7);
    border: 1px solid var(--border-glass);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--moon-400);
  }

  .monogram-text {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
  }

  .mobile-cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 600;
    color: var(--starlight-200);
    text-decoration: none;
  }
</style>
