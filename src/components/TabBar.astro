---
import strings from '../content/strings.en.json';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const cleanPath = currentPath.replace(/\/$/, '') || '/';

const tabs = [
  { href: '/', label: strings.nav.home, icon: 'home' },
  { href: '/about', label: strings.nav.about, icon: 'user' },
  { href: '/work', label: strings.nav.work, icon: 'briefcase' },
  { href: '/contact', label: strings.nav.contact, icon: 'mail' }
];
---
<nav class="mobile-tabbar-wrapper" transition:name="mobile-tabbar" aria-label="Mobile navigation">
  <div class="glass glass-capsule mobile-tabbar">
    {tabs.map((tab) => {
      const isActive = tab.href === '/'
        ? cleanPath === '/'
        : cleanPath.startsWith(tab.href);
      return (
        <a
          href={tab.href}
          class={`tab-item ${isActive ? 'active' : ''}`}
          aria-current={isActive ? 'page' : undefined}
        >
          {isActive && (
            <span class="active-pill" transition:name="active-mobile-pill" />
          )}
          <span class="tab-icon" aria-hidden="true">
            {tab.icon === 'home' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1V9.5z" />
              </svg>
            )}
            {tab.icon === 'user' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="4" />
                <path d="M20 21a8 8 0 0 0-16 0" />
              </svg>
            )}
            {tab.icon === 'briefcase' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" />
                <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
              </svg>
            )}
            {tab.icon === 'mail' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            )}
          </span>
          <span class="tab-label">{tab.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  .mobile-tabbar-wrapper {
    display: flex;
    position: fixed;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    left: 0;
    right: 0;
    z-index: 50;
    justify-content: center;
    pointer-events: none;
    padding-inline: 16px;
  }

  @media (min-width: 768px) {
    .mobile-tabbar-wrapper {
      display: none;
    }
  }

  .mobile-tabbar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 60px;
    padding: 4px 6px;
    border-radius: var(--radius-capsule);
    max-width: 360px;
    width: 100%;
    justify-content: space-around;
  }

  .tab-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 48px;
    min-width: 48px;
    flex: 1;
    padding: 4px 8px;
    border-radius: var(--radius-capsule);
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--duration-press) var(--ease-ios);
    z-index: 1;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }

  .tab-item.active {
    color: var(--text-1);
  }

  .active-pill {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-capsule);
    background: rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 2px 8px rgba(8, 8, 28, 0.4);
    z-index: -1;
  }

  .tab-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 24px;
    width: 24px;
  }

  .tab-label {
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
  }
</style>
