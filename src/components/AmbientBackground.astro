---
// Calm night sky depth stack (§5.2, §8): two radial gradient fields
---
<div class="ambient-layer" transition:name="bg-ambient" aria-hidden="true">
  <!-- Sky glow (cool depth) -->
  <div class="glow-orb orb-sky"></div>
  
  <!-- Moon glow (warm depth) -->
  <div class="glow-orb orb-moon"></div>
</div>

<style>
  .ambient-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
    background-color: var(--night-900);
  }

  .glow-orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
  }

  .orb-sky {
    top: -15vw;
    right: -10vw;
    width: 60vw;
    height: 60vw;
    max-width: 800px;
    max-height: 800px;
    background: radial-gradient(circle, rgba(111, 184, 230, 0.12) 0%, rgba(111, 184, 230, 0.02) 50%, transparent 70%);
    animation: drift-sky 60s var(--ease-standard) infinite alternate;
  }

  .orb-moon {
    bottom: -20vw;
    left: -15vw;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(236, 180, 77, 0.09) 0%, rgba(236, 180, 77, 0.02) 50%, transparent 70%);
    animation: drift-moon 75s var(--ease-standard) infinite alternate;
  }

  @keyframes drift-sky {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-4vw, 8vh, 0); }
  }

  @keyframes drift-moon {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(5vw, -6vh, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow-orb {
      animation: none !important;
    }
  }
</style>
