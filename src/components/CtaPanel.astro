---
import site from '../content/site.json';
import strings from '../content/strings.en.json';
---
<section class="cta-section section-shell" id="contact-cta" aria-labelledby="cta-heading">
  <div class="glass glass-hero cta-panel">
    <div class="cta-ambient-glow" aria-hidden="true"></div>

    <div class="cta-content">
      <span class="section-eyebrow">{strings.cta.eyebrow}</span>
      <h2 id="cta-heading" class="cta-title font-display">{strings.cta.heading}</h2>
      <p class="cta-desc">{strings.cta.subheading}</p>

      <div class="cta-actions">
        <a href={`mailto:${site.email}`} class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>{strings.cta.emailPutria}</span>
        </a>

        <button type="button" class="btn-secondary copy-email-btn" data-email={site.email}>
          <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="copy-label">{strings.cta.copyEmail}</span>
        </button>

        <a href="/cv.pdf" download="Putria_Octavianty_CV.pdf" class="btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>{strings.hero.downloadCv}</span>
        </a>
      </div>

      <p class="cta-location">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{strings.cta.locationNote}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    z-index: 10;
    margin-bottom: 60px;
  }

  @media (min-width: 768px) {
    .cta-section {
      margin-bottom: 80px;
    }
  }

  .cta-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(32px, 6vw, 64px);
    text-align: center;
    box-shadow: inset 0 1px 0 rgba(242, 225, 153, 0.22), 0 24px 64px -20px rgba(8, 8, 28, 0.85);
  }

  .cta-ambient-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse at center, rgba(236, 180, 77, 0.22) 0%, rgba(111, 184, 230, 0.12) 50%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .section-eyebrow {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--sky-400);
  }

  .cta-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    color: var(--starlight-200);
    line-height: 1.1;
  }

  .cta-desc {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 500px;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
    margin-bottom: 8px;
  }

  .cta-location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: var(--sky-400);
    margin-top: 8px;
  }
</style>

<script>
  import { copyToClipboard } from '../scripts/clipboard';

  function setupCopyButton() {
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('.copy-email-btn');
    copyBtns.forEach((btn) => {
      if (btn.dataset.copyBound === 'true') return;
      btn.dataset.copyBound = 'true';

      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email');
        const label = btn.querySelector<HTMLElement>('.copy-label');
        if (!email || !label) return;

        const success = await copyToClipboard(email);
        const original = label.textContent || 'Copy email';

        if (success) {
          label.textContent = 'Copied to clipboard!';
        } else {
          label.textContent = email;
        }

        setTimeout(() => {
          label.textContent = original;
        }, 2400);
      });
    });
  }

  setupCopyButton();
  document.addEventListener('astro:page-load', setupCopyButton);
</script>
