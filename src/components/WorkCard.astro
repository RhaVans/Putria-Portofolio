---
import AbstractCover from './AbstractCover.astro';

interface Props {
  experience: {
    id: string;
    slug: string;
    role: string;
    organization: string;
    orgType: string;
    period: string;
    tagline: string;
    skills: string[];
    abstractTheme: string;
  };
}

const { experience: exp } = Astro.props;
---
<article class="work-card-wrapper">
  <a
    href={`/work/${exp.slug}`}
    class="glass glass-card work-card glass-interactive"
    data-card-tilt
  >
    <!-- Cover Area with shared element transition -->
    <div class="card-cover-wrapper" transition:name={`work-cover-${exp.slug}`}>
      <AbstractCover theme={exp.abstractTheme} title={exp.role} />
      <span class="card-period-badge">{exp.period}</span>
    </div>

    <!-- Card Content -->
    <div class="card-body">
      <span class="card-org-type">{exp.orgType}</span>
      <h3 class="card-role-title font-display" transition:name={`work-title-${exp.slug}`}>
        {exp.role}
      </h3>
      <p class="card-org-name">{exp.organization}</p>
      <p class="card-tagline">{exp.tagline}</p>

      <!-- Skill chips -->
      <div class="card-skills-row" aria-label="Skills applied">
        {exp.skills.slice(0, 3).map((skill) => (
          <span class="skill-tag">{skill}</span>
        ))}
      </div>

      <div class="card-footer">
        <span class="view-link">
          <span>Read case details</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .work-card-wrapper {
    height: 100%;
    display: flex;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    position: relative;
    border-radius: var(--radius-card);
    transition: transform 0.25s var(--ease-out),
                box-shadow 0.25s var(--ease-out),
                border-color 0.25s var(--ease-out);
  }

  .card-cover-wrapper {
    position: relative;
    width: 100%;
    height: 180px;
    background: var(--night-700);
    overflow: hidden;
  }

  .card-period-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(25, 25, 57, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--border-glass);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    font-size: 11px;
    font-weight: 600;
    color: var(--starlight-200);
    letter-spacing: 0.02em;
  }

  .card-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
  }

  .card-org-type {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--sky-400);
  }

  .card-role-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--starlight-200);
    line-height: 1.25;
  }

  .card-org-name {
    font-size: 13.5px;
    color: var(--text-subtle);
    line-height: 1.4;
  }

  .card-tagline {
    font-size: 14.5px;
    color: var(--text-muted);
    line-height: 1.5;
    margin-top: 4px;
    flex: 1;
  }

  .card-skills-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .skill-tag {
    font-size: 11.5px;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: rgba(27, 58, 104, 0.55);
    border: 1px solid rgba(242, 225, 153, 0.12);
    color: var(--text-primary);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 12px;
    border-top: 1px solid rgba(242, 225, 153, 0.08);
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--moon-400);
    transition: transform var(--duration-micro) var(--ease-out);
  }

  .work-card:hover .view-link {
    transform: translateX(4px);
  }
</style>
