---
import experience from '../content/experience.json';
import strings from '../content/strings.en.json';

interface Props {
  showAllLink?: boolean;
}

const { showAllLink = true } = Astro.props;
---
<section class="work-chapter" id="work" aria-labelledby="work-heading">
  <div class="content-shell">
    <div class="work-header">
      <h2 id="work-heading" class="section-h2">{strings.work.heading}</h2>
      {showAllLink && (
        <a href="/work" class="all-work-link ui-label">
          <span>{strings.work.allWork}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      )}
    </div>

    <!-- Rows List with Hairlines (§5.3, §6.1) -->
    <div class="work-rows-list">
      {experience.map((exp) => (
        <a href={`/work/${exp.slug}`} class="work-row">
          <!-- Soft glass highlight on hover/press -->
          <span class="row-highlight" aria-hidden="true" />
          
          <div class="row-inner">
            <!-- Desktop: Col 1 (Dates); Mobile: part of meta -->
            <span class="row-dates text-caption tabular-date">{exp.period}</span>

            <!-- Col 2: Role & Organization -->
            <div class="row-primary">
              <h3 class="row-title" transition:name={`work-title-${exp.slug}`}>
                {exp.role}
              </h3>
              <p class="row-org text-body">{exp.organization}</p>
            </div>

            <!-- Col 3: Description -->
            <div class="row-desc text-body">
              {exp.description}
            </div>

            <!-- Chevron Icon -->
            <div class="row-chevron" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .work-chapter {
    padding-block: var(--section-pad-mobile);
  }

  @media (min-width: 1024px) {
    .work-chapter {
      padding-block: var(--section-pad-desktop);
    }
  }

  .work-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-7);
  }

  .all-work-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--sky-400);
    text-decoration: none;
    transition: color var(--duration-press) var(--ease-ios);
  }

  .all-work-link:hover {
    color: var(--text-1);
  }

  .work-rows-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hairline);
  }

  .work-row {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--hairline);
    padding-block: var(--space-5);
    padding-inline: var(--space-3);
    border-radius: var(--radius-sheet);
    transition: transform var(--duration-press) var(--ease-ios);
  }

  @media (min-width: 768px) {
    .work-row {
      padding-block: var(--space-6);
      padding-inline: var(--space-4);
    }
  }

  .row-highlight {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-sheet);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    opacity: 0;
    transition: opacity var(--duration-press) var(--ease-ios);
    pointer-events: none;
  }

  .work-row:hover .row-highlight {
    opacity: 1;
  }

  .work-row:active {
    transform: scale(0.99);
  }

  .row-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 1024px) {
    .row-inner {
      display: grid;
      grid-template-columns: 180px 1.2fr 1.8fr 32px;
      align-items: baseline;
      gap: var(--space-6);
    }
  }

  .row-dates {
    color: var(--text-3);
  }

  .row-primary {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .row-title {
    color: var(--text-1);
    transition: color var(--duration-press) var(--ease-ios);
  }

  .work-row:hover .row-title {
    color: var(--sky-400);
  }

  .row-org {
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .row-desc {
    color: var(--text-2);
    font-size: 1rem;
    line-height: 1.5;
  }

  .row-chevron {
    display: none;
    color: var(--text-3);
    align-self: center;
    transition: transform var(--duration-press) var(--ease-ios), color var(--duration-press) var(--ease-ios);
  }

  @media (min-width: 1024px) {
    .row-chevron {
      display: flex;
      justify-content: flex-end;
    }
  }

  .work-row:hover .row-chevron {
    color: var(--sky-400);
    transform: translateX(3px);
  }
</style>
