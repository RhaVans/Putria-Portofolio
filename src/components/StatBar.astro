---
import site from '../content/site.json';
---
<section class="statbar-section section-shell" aria-label="Key background statistics">
  <div class="glass glass-card statbar-container">
    {site.stats.map((item, idx) => (
      <div class="stat-item">
        <span class="stat-number font-display">{item.value}</span>
        <span class="stat-label">{item.label}</span>
        {idx < site.stats.length - 1 && <span class="stat-divider" aria-hidden="true"></span>}
      </div>
    ))}
  </div>
</section>

<style>
  .statbar-section {
    position: relative;
    z-index: 10;
    margin-top: 10px;
    margin-bottom: 50px;
  }

  @media (min-width: 768px) {
    .statbar-section {
      margin-top: 20px;
      margin-bottom: 70px;
    }
  }

  .statbar-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    padding: 24px;
    box-shadow: inset 0 1px 0 rgba(242, 225, 153, 0.18), 0 20px 48px -18px rgba(8, 8, 28, 0.65);
  }

  @media (min-width: 768px) {
    .statbar-container {
      grid-template-columns: repeat(4, 1fr);
      padding: 20px 32px;
      gap: 0;
    }
  }

  .stat-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
  }

  .stat-number {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    color: var(--starlight-200);
    line-height: 1;
  }

  .stat-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .stat-divider {
    display: none;
  }

  @media (min-width: 768px) {
    .stat-divider {
      display: block;
      position: absolute;
      right: 0;
      top: 20%;
      height: 60%;
      width: 1px;
      background: var(--border-glass);
    }
  }
</style>
