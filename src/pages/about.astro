---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';
import strings from '../content/strings.en.json';

const groupedDetails = [
  { label: strings.about.skillsLabel, value: strings.about.skillsValue },
  { label: strings.about.languagesLabel, value: strings.about.languagesValue },
  { label: strings.about.educationLabel, value: strings.about.educationValue },
  { label: strings.about.locationLabel, value: strings.about.locationValue }
];
---
<Base
  title={`About — ${site.name}`}
  description={`Background, education, languages, and competencies of ${site.name}.`}
>
  <div class="about-page content-shell">
    <header class="page-header">
      <h1 class="section-h2">{strings.about.heading}</h1>
    </header>

    <!-- Bio Statement -->
    <div class="bio-block">
      <p class="text-body bio-text">{strings.about.bio}</p>
    </div>

    <!-- Grouped List Surface (§5.4, §6.2) -->
    <div class="surface-grouped about-grouped-list" role="list">
      {groupedDetails.map((item) => (
        <div class="grouped-row" role="listitem">
          <span class="row-label ui-label">{item.label}</span>
          <span class="row-val text-body">{item.value}</span>
        </div>
      ))}
    </div>

    <!-- CV Action -->
    <div class="about-action">
      <a href="/cv.pdf" download="Putria_Octavianty_CV.pdf" class="btn-glass glass">
        <span>Download CV</span>
      </a>
    </div>
  </div>

  <Footer />
</Base>

<style>
  .about-page {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 820px;
  }

  @media (min-width: 768px) {
    .about-page {
      padding-top: var(--space-9);
      gap: var(--space-7);
    }
  }

  .bio-block {
    max-width: 62ch;
  }

  .bio-text {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-1);
  }

  /* Grouped list container (§5.4) */
  .about-grouped-list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-2);
  }

  .grouped-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }

  .grouped-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .grouped-row {
      display: grid;
      grid-template-columns: 160px 1fr;
      align-items: baseline;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-6);
    }
  }

  .row-label {
    color: var(--sky-400);
  }

  .row-val {
    color: var(--text-1);
  }

  .about-action {
    display: flex;
    align-items: center;
    margin-top: var(--space-3);
  }
</style>
