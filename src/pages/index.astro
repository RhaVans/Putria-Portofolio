---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatBar from '../components/StatBar.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import Capabilities from '../components/Capabilities.astro';
import Process from '../components/Process.astro';
import CtaPanel from '../components/CtaPanel.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';
---
<Base title={`${site.name} — ${site.tagline}`}>
  <Hero />
  <StatBar />
  <FeaturedWork />
  <Capabilities />
  <Process />
  <CtaPanel />
  <Footer />
</Base>
