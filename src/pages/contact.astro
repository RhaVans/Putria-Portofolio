---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';
import strings from '../content/strings.en.json';
---
<Base
  title={`Contact — ${site.name}`}
  description={`Get in touch with ${site.name}. Email is the best way to connect.`}
>
  <div class="contact-page content-shell">
    <div class="contact-content">
      <h1 class="section-h2">{strings.contact.heading}</h1>
      <p class="text-body contact-line">{strings.contact.line}</p>

      <a href={`mailto:${site.email}`} class="contact-email-link">
        {site.email}
      </a>

      <div class="contact-actions">
        <a href={`mailto:${site.email}`} class="btn-primary">
          <span>{strings.contact.emailPutria}</span>
        </a>
        <button type="button" class="btn-glass glass page-copy-btn" data-email={site.email}>
          <span class="page-copy-label">{strings.contact.copyEmail}</span>
        </button>
        <a href="/cv.pdf" download="Putria_Octavianty_CV.pdf" class="btn-glass glass">
          <span>{strings.contact.downloadCv}</span>
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Base>

<style>
  .contact-page {
    padding-top: var(--space-7);
    padding-bottom: var(--space-8);
    display: flex;
    align-items: center;
    min-height: calc(100svh - 180px);
  }

  @media (min-width: 768px) {
    .contact-page {
      padding-top: var(--space-9);
      min-height: calc(100svh - 220px);
    }
  }

  .contact-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 760px;
  }

  @media (min-width: 1024px) {
    .contact-content {
      gap: var(--space-5);
    }
  }

  .contact-line {
    color: var(--text-2);
  }

  .contact-email-link {
    display: inline-block;
    font-size: clamp(1.5rem, 4.5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sky-400);
    text-decoration: none;
    word-break: break-all;
    margin-block: var(--space-3);
    transition: color var(--duration-press) var(--ease-ios);
  }

  .contact-email-link:hover {
    color: var(--text-1);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>

<script>
  import { copyToClipboard } from '../scripts/clipboard';

  function setupPageCopy() {
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('.page-copy-btn');
    copyBtns.forEach((btn) => {
      if (btn.dataset.copyBound === 'true') return;
      btn.dataset.copyBound = 'true';

      btn.addEventListener('click', async () => {
        const email = btn.getAttribute('data-email');
        const label = btn.querySelector<HTMLElement>('.page-copy-label');
        if (!email || !label) return;

        const success = await copyToClipboard(email);
        const original = label.textContent || 'Copy email';

        if (success) {
          label.textContent = 'Copied to clipboard!';
        } else {
          label.textContent = email;
        }

        setTimeout(() => {
          label.textContent = original;
        }, 2200);
      });
    });
  }

  setupPageCopy();
  document.addEventListener('astro:page-load', setupPageCopy);
</script>
