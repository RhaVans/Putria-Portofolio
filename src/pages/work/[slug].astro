---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import site from '../../content/site.json';
import strings from '../../content/strings.en.json';
import experience from '../../content/experience.json';

export function getStaticPaths() {
  return experience.map((exp, index) => {
    const prev = index > 0 ? experience[index - 1] : null;
    const next = index < experience.length - 1 ? experience[index + 1] : null;
    return {
      params: { slug: exp.slug },
      props: { exp, prev, next }
    };
  });
}

const { exp, prev, next } = Astro.props;
---
<Base
  title={`${exp.role} — ${site.name}`}
  description={`${exp.role} at ${exp.organization} (${exp.period}).`}
>
  <div class="detail-page content-shell">
    <!-- Back to work -->
    <nav class="back-nav" aria-label="Breadcrumb">
      <a href="/work" class="back-link ui-label">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        <span>{strings.work.backToWork}</span>
      </a>
    </nav>

    <!-- Detail Header (§4) -->
    <header class="detail-header">
      <h1 class="section-h2 detail-title" transition:name={`work-title-${exp.slug}`}>
        {exp.role}
      </h1>
      <p class="detail-meta text-body">
        {exp.organization} · <span class="tabular-date">{exp.period}</span>
      </p>
    </header>

    <!-- Description Sentence (§4) -->
    <div class="detail-body">
      <p class="text-body detail-desc">{exp.description}</p>
    </div>

    <!-- Grouped List Surface (§4, §5.4) -->
    <div class="surface-grouped detail-grouped-list" role="list">
      <div class="grouped-row" role="listitem">
        <span class="row-label ui-label">{strings.work.roleLabel}</span>
        <span class="row-val text-body">{exp.role}</span>
      </div>
      <div class="grouped-row" role="listitem">
        <span class="row-label ui-label">{strings.work.orgLabel}</span>
        <span class="row-val text-body">{exp.organization}</span>
      </div>
      <div class="grouped-row" role="listitem">
        <span class="row-label ui-label">{strings.work.datesLabel}</span>
        <span class="row-val text-body tabular-date">{exp.period}</span>
      </div>
    </div>

    <!-- Previous / Next Navigation (§4) -->
    <nav class="detail-pagination" aria-label="Project navigation">
      {prev ? (
        <a href={`/work/${prev.slug}`} class="pag-link prev-link">
          <span class="pag-dir text-caption">Previous</span>
          <span class="pag-title ui-label">{prev.role}</span>
        </a>
      ) : <div />}

      {next && (
        <a href={`/work/${next.slug}`} class="pag-link next-link">
          <span class="pag-dir text-caption">Next</span>
          <span class="pag-title ui-label">{next.role}</span>
        </a>
      )}
    </nav>
  </div>

  <Footer />
</Base>

<style>
  .detail-page {
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 820px;
  }

  @media (min-width: 768px) {
    .detail-page {
      padding-top: var(--space-8);
      gap: var(--space-7);
    }
  }

  .back-nav {
    margin-bottom: var(--space-2);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--sky-400);
    text-decoration: none;
    min-height: 48px;
    transition: color var(--duration-press) var(--ease-ios);
  }

  .back-link:hover {
    color: var(--text-1);
  }

  .detail-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .detail-title {
    color: var(--text-1);
  }

  .detail-meta {
    color: var(--text-2);
    font-size: 1.125rem;
  }

  .detail-desc {
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--text-1);
    max-width: 62ch;
  }

  /* Grouped list container */
  .detail-grouped-list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-2);
  }

  .grouped-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }

  .grouped-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .grouped-row {
      display: grid;
      grid-template-columns: 160px 1fr;
      align-items: baseline;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-6);
    }
  }

  .row-label {
    color: var(--sky-400);
  }

  .row-val {
    color: var(--text-1);
  }

  /* Pagination */
  .detail-pagination {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--hairline);
    margin-top: var(--space-4);
  }

  .pag-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    transition: transform var(--duration-press) var(--ease-ios);
  }

  .pag-link:active {
    transform: scale(0.98);
  }

  .prev-link {
    align-items: flex-start;
    text-align: left;
  }

  .next-link {
    align-items: flex-end;
    text-align: right;
  }

  .pag-dir {
    color: var(--text-3);
  }

  .pag-title {
    color: var(--sky-400);
    transition: color var(--duration-press) var(--ease-ios);
  }

  .pag-link:hover .pag-title {
    color: var(--text-1);
  }
</style>
